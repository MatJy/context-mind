# Optional API title. Empty values use the built-in default: Context Mind API.
APP_NAME=

# Empty values use defaults: ollama, http://localhost:11434, llama3.2:3b, 120.
LLM_PROVIDER=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=

# PostgreSQL persistence is disabled until set. Use postgresql+psycopg://user:password@localhost:5432/context_mind
DATABASE_URL=

# Used only by infra/compose.postgres.yml. Keep the real password in .env.
POSTGRES_PASSWORD=

# Local embeddings via Ollama. Empty values use defaults:
# local, http://localhost:11434, nomic-embed-text:v1.5, 768, 16, 120.
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=
EMBEDDING_TIMEOUT_SECONDS=

# Semantic search default match count (1-20). Empty uses 5.
RETRIEVAL_TOP_K=
